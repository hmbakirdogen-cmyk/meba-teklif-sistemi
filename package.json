{
  "name": "group-companies-teklif-sistemi",
  "productName": "Grup Şirketleri Teklif Sistemi",
  "description": "MEBA · MESA · ELMOS Grup Şirketleri — Profesyonel teklif hazırlama ve yönetim sistemi",
  "author": "MEBA · MESA · ELMOS Grup Şirketleri",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev:server\" \"vite\"",
    "dev:server": "tsx watch server/app/index.ts",
    "build": "tsc -b && vite build",
    "start:prod": "prisma migrate resolve --rolled-back 20260526120000_add_unvan_cinsiyet || true && prisma migrate deploy && exec node --import tsx server/app/index.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "migrate:data": "tsx scripts/migrate/db-json-to-postgres.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "meba": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start-meba.ps1",
    "meba:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start-meba.ps1 -LiveApi",
    "meba:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-meba-launcher.ps1",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/react": "^6.0.2",
    "@prisma/client": "^6.0.0",
    "@vladmandic/face-api": "^1.7.15",
    "antd": "^6.3.5",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^17.0.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.0.1",
    "html2canvas": "^1.4.1",
    "imapflow": "^1.3.3",
    "jspdf": "^4.2.1",
    "node-cron": "^4.0.0",
    "nodemailer": "^7.0.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.0",
    "@types/node": "^24.12.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prisma": "^6.0.0",
    "terser": "^5.36.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
